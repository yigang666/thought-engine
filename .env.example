# Optional. The app does not need this file for Google sign-in.
# The session secret is created automatically under data/.
# A Google client, if one is already on this machine, is stored in data/ as well.
# data/ is gitignored. Do not commit secrets.

# API keys stay here only if a later step calls a model.
# Reading and Google sign-in do not use them.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
